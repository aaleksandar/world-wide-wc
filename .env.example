# --- chain ---------------------------------------------------------------
# Base Sepolia. A throwaway key — this wallet only ever holds faucet ETH and
# relays contributions. Never a personal key.
DEPLOYER_PRIVATE_KEY=0x
RELAYER_PRIVATE_KEY=0x
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Which network the subgraph indexes. Anything in The Graph's networks registry.
SUBGRAPH_NETWORK=base-sepolia

# Set by scripts/deploy.ts after deployment.
NEXT_PUBLIC_WWWC_ADDRESS=
NEXT_PUBLIC_WWWC_START_BLOCK=

# --- the graph -----------------------------------------------------------
# From studio.thegraph.com. The subgraph is the app's only read path.
NEXT_PUBLIC_SUBGRAPH_URL=
# Deploy key from the Studio dashboard.
GRAPH_DEPLOY_KEY=

# --- photos --------------------------------------------------------------
# Photos go to IPFS; only the ipfs:// URI goes onchain. Defaults below work with no
# account at all — The Graph's IPFS node to add, ipfs.io to read.
IPFS_API_URL=https://api.thegraph.com/ipfs/api/v0
NEXT_PUBLIC_IPFS_GATEWAY=https://ipfs.io/ipfs

# Optional but recommended: a second pin, so photos outlive the demo. The Graph's node
# is meant for subgraph manifests and may garbage-collect a stranger's photo.
PINATA_JWT=

# --- the judge ------------------------------------------------------------
# The judge reasons over gathered evidence, so a modest model is enough — but it does
# need one. Either works; ANTHROPIC_API_KEY takes precedence when both are set.
#
# Vercel AI Gateway key, starts with `vck_`, from vercel.com/[team]/~/ai-gateway/api-keys.
# Note the free tier refuses the better models and throttles hard; a small paid top-up at
# vercel.com/[team]/~/ai is what makes judging a whole city practical.
AI_GATEWAY_API_KEY=
ANTHROPIC_API_KEY=
# Override the model. Defaults to openai/gpt-oss-120b on the Gateway (free tier serves it)
# or claude-sonnet-5 when going to Anthropic directly.
WWWC_MODEL=

# --- agents ---------------------------------------------------------------
# For the MCP server: the wallet your agent contributes as, and the address rewards
# accrue to. A throwaway key is fine — it never needs to hold funds, because the relayer
# pays the gas.
WWWC_AGENT_PRIVATE_KEY=
# Where the MCP server and test scripts post contributions.
WWWC_APP_URL=http://localhost:3000
APP_URL=http://localhost:3000