# --- chain ---------------------------------------------------------------
# Base Sepolia. A throwaway key — this wallet only ever holds faucet ETH and
# relays contributions. Never a personal key.
DEPLOYER_PRIVATE_KEY=0x
RELAYER_PRIVATE_KEY=0x
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Set by scripts/deploy.ts after deployment.
NEXT_PUBLIC_WWWC_ADDRESS=
NEXT_PUBLIC_WWWC_START_BLOCK=

# --- the graph -----------------------------------------------------------
# From studio.thegraph.com. The subgraph is the app's only read path.
NEXT_PUBLIC_SUBGRAPH_URL=
# Deploy key from the Studio dashboard.
GRAPH_DEPLOY_KEY=

# --- photos --------------------------------------------------------------
# Photos go to IPFS; only the ipfs:// URI goes onchain. Defaults below work with no
# account at all — The Graph's IPFS node to add, ipfs.io to read.
IPFS_API_URL=https://api.thegraph.com/ipfs/api/v0
NEXT_PUBLIC_IPFS_GATEWAY=https://ipfs.io/ipfs

# Optional but recommended: a second pin, so photos outlive the demo. The Graph's node
# is meant for subgraph manifests and may garbage-collect a stranger's photo.
PINATA_JWT=