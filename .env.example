# --- chain ---------------------------------------------------------------
# Base Sepolia. A throwaway key — this wallet only ever holds faucet ETH and
# relays contributions. Never a personal key.
DEPLOYER_PRIVATE_KEY=0x
RELAYER_PRIVATE_KEY=0x
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Set by scripts/deploy.ts after deployment.
NEXT_PUBLIC_WWWC_ADDRESS=
NEXT_PUBLIC_WWWC_START_BLOCK=

# --- the graph -----------------------------------------------------------
# From studio.thegraph.com. The subgraph is the app's only read path.
NEXT_PUBLIC_SUBGRAPH_URL=
# Deploy key from the Studio dashboard.
GRAPH_DEPLOY_KEY=

# --- ai ------------------------------------------------------------------
# Vercel AI Gateway key, for the natural-language toilet finder. Starts with `vck_`;
# create one at https://vercel.com/[team]/~/ai-gateway/api-keys
# `npm run check:ai-key` will tell you whether it works.
AI_GATEWAY_API_KEY=
# Or skip the Gateway entirely and bill Anthropic directly. Either one works.
ANTHROPIC_API_KEY=

# --- photos --------------------------------------------------------------
BLOB_READ_WRITE_TOKEN=
